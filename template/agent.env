# data/agent/.env, sourced in the VM at the start of every session (agent and `sbx exec`).
# Mounted read-only, never versioned. POSIX sh syntax (dash): `export X=...`, no $(pwd).
# $AGENT_DIR is set by the loader = this folder, same path on the Mac and in the VM.
#
# Everything here is readable in clear text inside the VM. For a simple bearer-token API
# (Hetzner, Scaleway, ArgoCD), prefer `sbx secret`: the proxy injects the key, the VM never sees it.
# Ephemeral tokens (AWS STS, gcloud 1h) go in .env.session, generated by `harness env`.

export KUBECONFIG="$AGENT_DIR/kubeconfig"

# --- Kubernetes / GitOps ---------------------------------------------------
# export ARGOCD_SERVER=argocd.lan
# export HUBBLE_SERVER=hubble.lan:4245

# --- Cloud (read-only identities only) -------------------------------------
# export HCLOUD_TOKEN=...                       # "Read" token, or sbx secret
# export SCW_ACCESS_KEY=... SCW_SECRET_KEY=...  # ReadOnly policy, or sbx secret
# export SCW_DEFAULT_PROJECT_ID=... SCW_DEFAULT_REGION=fr-par
# export OVH_ENDPOINT=ovh-eu OVH_APPLICATION_KEY=... OVH_APPLICATION_SECRET=... OVH_CONSUMER_KEY=...   # rights GET /* only
# export AZURE_CLIENT_ID=... AZURE_TENANT_ID=... AZURE_CLIENT_SECRET=...   # "Reader" SP; login via .harness/post-create.sh
# export AWS_REGION=eu-west-3                   # temporary creds go in .env.session
# export CLOUDSDK_CORE_PROJECT=...              # 1h token goes in .env.session

# --- Terraform / OpenTofu --------------------------------------------------
# export TF_CLI_ARGS_plan="-lock=false"         # plan without a lock on a read-only state
# export TF_PLUGIN_CACHE_DIR="$HOME/.terraform.d/plugin-cache"
